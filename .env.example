# ============================================================
# VARIABLES DE ENTORNO — NUNCA subas el .env real a control de versiones
# Copia este archivo como .env y completa los valores reales
# ============================================================

# Número WhatsApp de la constructora (formato sin espacios)
WHATSAPP_NUMBER=56912345678

# Servicio de correo para leads del formulario de cotización
# Ejemplo con Resend: https://resend.com
EMAIL_SERVICE_API_KEY=TU_API_KEY_AQUI
EMAIL_FROM=noreply@TU_DOMINIO.cl
EMAIL_TO=contacto@TU_DOMINIO.cl

# URL pública del sitio (sin barra final)
PUBLIC_SITE_URL=https://www.TU_DOMINIO.cl

# Opcional: Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
