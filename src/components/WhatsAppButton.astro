---
const WHATSAPP_NUMBER = import.meta.env.WHATSAPP_NUMBER ?? '56912345678';
const MESSAGE = encodeURIComponent(
  'Hola, me gustaría obtener más información para reservar mi estadía o visita en Altos de Quelén.'
);
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${MESSAGE}`;
---

<a
  id="whatsapp-btn"
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="fixed bottom-8 right-6 z-40 flex items-center gap-3 group opacity-0"
  data-cursor-hover
>
  <!-- Pulse ring -->
  <span class="absolute inset-0 rounded-full bg-[#25D366]/20 animate-heartbeat"
        aria-hidden="true"></span>

  <!-- Button body -->
  <div class="relative w-14 h-14 rounded-full bg-[#25D366] flex items-center justify-center
              shadow-lg shadow-[#25D366]/20 transition-transform duration-300
              group-hover:scale-110">
    <!-- WhatsApp icon SVG -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-7 h-7 text-white"
      aria-hidden="true"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15
           -.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463
           -2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606
           .134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025
           -.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008
           -.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479
           0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306
           1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719
           2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
      />
      <path
        d="M12 0C5.373 0 0 5.373 0 12c0 2.109.549 4.09 1.505 5.815L.057 23.016
           a.75.75 0 00.927.927l5.201-1.448A11.94 11.94 0 0012 24c6.627 0 12-5.373
           12-12S18.627 0 12 0zm0 21.75a9.738 9.738 0 01-4.97-1.362l-.356-.212
           -3.685 1.026 1.027-3.685-.213-.357A9.738 9.738 0 012.25 12C2.25 6.615
           6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"
      />
    </svg>
  </div>

  <!-- Tooltip label -->
  <span class="absolute right-16 whitespace-nowrap bg-concrete-900 text-concrete-100
               font-sans text-xs px-3 py-2 border border-bronze-500/20
               opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0
               transition-all duration-300 pointer-events-none">
    Escríbenos por WhatsApp
  </span>
</a>

<script>
  import { gsap } from 'gsap';

  /* ── Show button after 3 seconds ── */
  gsap.to('#whatsapp-btn', {
    opacity: 1,
    y: 0,
    duration: 0.6,
    ease: 'power3.out',
    delay: 3,
  });
</script>
