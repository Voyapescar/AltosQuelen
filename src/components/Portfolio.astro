---
// Espacio para importar datos si es necesario en el futuro
---

<section id="portafolio" class="py-32 md:py-44 bg-concrete-950">
  <div class="container-site">

    <!-- Header row -->
    <div class="mb-20 md:mb-24">
      <div>
        <p class="section-label mb-4 opacity-reveal">Conoce el Complejo</p>
        <h2 class="heading-xl text-concrete-50 opacity-reveal" style="transition-delay:0.1s">
          Nuestras <em class="text-bronze-400 not-italic">Instalaciones</em>
        </h2>
      </div>
    </div>
    <!-- Symmetrical 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Item 1: Photo 1 -->
      <div class="group relative w-full aspect-[3/4] rounded-[2rem] overflow-hidden shadow-xl border border-bronze-500/10 bg-concrete-900 transition-all duration-500 hover:-translate-y-3 hover:shadow-[0_15px_40px_rgba(212,175,55,0.2)] opacity-reveal" style="transition-delay:0.05s">
        <img src="/images/Imagen1Quelen.png" alt="Instalaciones 1" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-concrete-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
      </div>

      <!-- Item 2: Photo 2 -->
      <div class="group relative w-full aspect-[3/4] rounded-[2rem] overflow-hidden shadow-xl border border-bronze-500/10 bg-concrete-900 transition-all duration-500 hover:-translate-y-3 hover:shadow-[0_15px_40px_rgba(212,175,55,0.2)] opacity-reveal" style="transition-delay:0.15s">
        <img src="/images/Imagen2Quelen.png" alt="Instalaciones 2" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-concrete-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
      </div>

      <!-- Item 3: Video -->
      <div class="group relative w-full aspect-[3/4] rounded-[2rem] overflow-hidden shadow-xl border border-bronze-500/10 bg-black transition-all duration-500 hover:-translate-y-3 hover:shadow-[0_15px_40px_rgba(212,175,55,0.2)] opacity-reveal" style="transition-delay:0.25s">
        <video src="/images/Video Quelen.mp4" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" controls playsinline preload="metadata"></video>
        <div class="absolute inset-0 bg-gradient-to-t from-concrete-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
      </div>

    </div>



  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /* ── Generic opacity reveal ── */
  gsap.utils.toArray<HTMLElement>('.opacity-reveal').forEach((el) => {
    if (document.querySelector('#portafolio')?.contains(el)) {
      gsap.fromTo(el,
        { opacity: 0, y: 30 },
        {
          opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%' },
        }
      );
    }
  });

  /* ── Simple card reveal on scroll (optimized) ── */
  gsap.utils.toArray<HTMLElement>('.portfolio-card').forEach((card) => {
    gsap.fromTo(card,
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
        },
      }
    );
  });
</script>
