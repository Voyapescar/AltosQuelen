---
import CotizacionForm from './CotizacionForm.tsx';
---

<section id="cotizacion" class="py-32 md:py-44 bg-surface relative overflow-hidden">

  <!-- Decorative background element -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute right-0 top-0 w-1/2 h-full
                bg-gradient-to-l from-bronze-500/3 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-bronze-500/10"></div>
  </div>

  <div class="container-site relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-8 items-start">

      <!-- Left: Info panel -->
      <div class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-28">
        <p class="section-label mb-5 opacity-reveal">Reservas e Información</p>
        <h2 class="heading-xl text-concrete-50 mb-6 opacity-reveal" style="transition-delay:0.1s">
          Planifica tu<br />
          <em class="text-bronze-400 not-italic">Visita</em>
        </h2>
        <p class="font-sans text-base text-concrete-400 leading-relaxed mb-10 opacity-reveal"
           style="transition-delay:0.2s">
          Completa el formulario y nuestro equipo te contactará
          para ayudarte a planificar tu visita, reservar cabañas o darte información sobre nuestras piscinas y espacios.
        </p>

      </div>

      <!-- Right: Form -->
      <div class="lg:col-span-7 xl:col-span-7 xl:col-start-6">
        <div class="bg-concrete-900 rounded-3xl border border-bronze-500/20 p-7 md:p-10 opacity-reveal shadow-xl" style="transition-delay:0.15s">
          <CotizacionForm client:visible />
        </div>
      </div>

    </div>

    <!-- Contact info cards -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-4 opacity-reveal" style="transition-delay:0.3s">

      <a
        href="tel:+56992671183"
        class="flex items-center gap-4 p-4 border border-bronze-500/15
               hover:border-bronze-500/40 transition-all duration-300 group rounded-2xl bg-concrete-800/20"
      >
        <div class="w-10 h-10 border border-bronze-500/20 flex items-center justify-center rounded-xl
                    group-hover:border-bronze-500/60 transition-colors duration-300 bg-concrete-800/40">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5" class="text-bronze-500">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0
                     013.41 7.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012.18 0h3a2 2 0
                     012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91
                     7.91a16 16 0 006.08 6.08l1.27-1.27a2 2 0 012.11-.45c.907.339
                     1.85.573 2.81.7A2 2 0 0122 16.92z"/>
          </svg>
        </div>
        <div>
          <p class="font-sans text-xs uppercase tracking-widest text-concrete-500 mb-0.5">Teléfono</p>
          <p class="font-sans text-sm text-concrete-200">+56 9 2671 183</p>
        </div>
      </a>

      <a
        href="mailto:contacto@altosdequelen.cl"
        class="flex items-center gap-4 p-4 border border-bronze-500/15
               hover:border-bronze-500/40 transition-all duration-300 group rounded-2xl bg-concrete-800/20"
      >
        <div class="w-10 h-10 border border-bronze-500/20 flex items-center justify-center rounded-xl
                    group-hover:border-bronze-500/60 transition-colors duration-300 bg-concrete-800/40">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5" class="text-bronze-500">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div>
          <p class="font-sans text-xs uppercase tracking-widest text-concrete-500 mb-0.5">Email</p>
          <p class="font-sans text-sm text-concrete-200">contacto@altosdequelen.cl</p>
        </div>
      </a>

      <div class="flex items-center gap-4 p-4 border border-bronze-500/15 rounded-2xl bg-concrete-800/20">
        <div class="w-10 h-10 border border-bronze-500/20 flex items-center justify-center rounded-xl bg-concrete-800/40">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5" class="text-bronze-500">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12,6 12,12 16,14"/>
          </svg>
        </div>
        <div>
          <p class="font-sans text-xs uppercase tracking-widest text-concrete-500 mb-0.5">Horario</p>
          <p class="font-sans text-sm text-concrete-200">Mar – Dom, 09:00 – 20:00</p>
        </div>
      </div>

    </div>

    <!-- Location Map (Optimized for performance - no scroll reveal) -->
    <div id="ubicacion" class="mt-20">
      <div class="border border-bronze-500/10 p-2 md:p-4 relative group rounded-3xl bg-concrete-950">
         <div class="w-full h-[450px] overflow-hidden bg-concrete-950 rounded-2xl relative z-10">
           <!-- Background Image from Hero -->
           <div class="absolute inset-0 bg-[url('/images/FotoHeroPro.png')] bg-cover bg-center opacity-30"></div>
           <!-- Dark tint over the image so roads are readable -->
           <div class="absolute inset-0 bg-concrete-950/90 pointer-events-none"></div>
           
           <iframe
             src="https://maps.google.com/maps?q=Altos%20de%20Quelen%20complejo%20tur%C3%ADstico&t=&z=16&ie=UTF8&iwloc=&output=embed"
             width="100%"
             height="100%"
             style="border:0; filter: invert(100%) grayscale(100%) contrast(90%);"
             allowfullscreen=""
             loading="lazy"
             referrerpolicy="no-referrer-when-downgrade"
             class="w-full h-full relative z-10 mix-blend-screen opacity-100"
           ></iframe>
         </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('#cotizacion .opacity-reveal').forEach((el) => {
    gsap.fromTo(el,
      { opacity: 0, y: 30 },
      {
        opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 85%' },
      }
    );
  });
</script>
