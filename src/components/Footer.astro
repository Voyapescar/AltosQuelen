---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Instalaciones', href: '/#portafolio' },
  { label: 'Reseñas',       href: '/#testimonios' },
  { label: 'Reservas',      href: '/#cotizacion' },
  { label: 'Ubicación',     href: '/#ubicacion' },
];

const legalLinks = [
  { label: 'Política de Privacidad', href: '/privacidad'       },
  { label: 'Términos de Uso',        href: '/terminos'         },
];
---

<footer id="footer" class="bg-concrete-950 border-t border-bronze-500/10 pt-20 pb-10">
  <div class="container-site">

    <!-- Top row -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 mb-16">

      <!-- Brand column -->
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-3 mb-6 group">
          <img src="/images/LogoQuelen.png" alt="Logo Quelen" class="h-12 w-auto object-contain grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300" />
        </a>
        <p class="font-sans text-sm text-concrete-500 leading-relaxed max-w-sm mb-8">
          Complejo turístico y deportivo Altos de Quelén en Cañete. Piscinas climatizadas, salón de eventos y cabañas. Abierto de Martes a Domingo.
        </p>

        <!-- Social icons -->
        <div class="flex gap-4">
          {[
            {
              name: 'Instagram',
              href: 'https://instagram.com/TU_USUARIO',
              path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
            },
            {
              name: 'LinkedIn',
              href: 'https://linkedin.com/company/TU_EMPRESA',
              path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
            },
          ].map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="w-9 h-9 border border-bronze-500/20 flex items-center justify-center
                     text-concrete-500 hover:text-bronze-400 hover:border-bronze-500/60
                     transition-all duration-300"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d={social.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation column -->
      <div class="md:col-span-3 md:col-start-7">
        <p class="section-label mb-6">Navegación</p>
        <ul class="space-y-4" role="list">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="font-sans text-sm text-concrete-400 hover:text-bronze-400
                       transition-colors duration-300"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div class="md:col-span-3 md:col-start-10">
        <p class="section-label mb-6">Contacto</p>
        <ul class="space-y-4 font-sans text-sm text-concrete-400" role="list">
          <li>
            <a href="tel:+56992671183" class="hover:text-bronze-400 transition-colors duration-300">
              +56 9 2671 183
            </a>
          </li>
          <li>
            <a href="mailto:contacto@altosdequelen.cl"
               class="hover:text-bronze-400 transition-colors duration-300">
              contacto@altosdequelen.cl
            </a>
          </li>
          <li class="text-concrete-500 leading-relaxed">
            Cañete, Chile<br />
            Provincia de Arauco
          </li>
          <li class="text-concrete-500">
            Mar – Dom · 09:00 – 20:00
          </li>
        </ul>
      </div>

    </div>

    <!-- Divider -->
    <div class="h-px bg-bronze-500/10 mb-8"></div>

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-xs text-concrete-600">
        © {currentYear} Complejo Turístico Altos de Quelén. Todos los derechos reservados.
      </p>
      <ul class="flex gap-6" role="list">
        {legalLinks.map(link => (
          <li>
            <a
              href={link.href}
              class="font-sans text-xs text-concrete-600 hover:text-concrete-400
                     transition-colors duration-300"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /* ── Footer columns stagger ── */
  const footerCols = document.querySelectorAll('#footer .grid > div');
  if (footerCols.length) {
    gsap.fromTo(footerCols,
      { opacity: 0, y: 30 },
      {
        opacity: 1, y: 0,
        stagger: 0.15,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: { trigger: '#footer', start: 'top 88%' },
      }
    );
  }

  /* ── Bottom bar fade ── */
  const bottomBar = document.querySelector('#footer .flex.flex-col.sm\\:flex-row');
  if (bottomBar) {
    gsap.fromTo(bottomBar,
      { opacity: 0 },
      {
        opacity: 1, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: bottomBar, start: 'top 95%' },
      }
    );
  }
</script>
